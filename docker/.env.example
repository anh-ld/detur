# detur env — edit in place, then `docker compose up -d --build`.
# No secrets in the image; everything here is runtime config (R18).
# All defaults are safe for localhost/LAN dev.
#
# TLS is a deployment requirement: the SDK's bearer apiKey + device
# fingerprints must never travel over plain http (R3/R4). In production set
# DETUR_DOMAIN to a real domain and terminate TLS in front of 8080 (see
# docs/guide.md -> Deploy -> TLS), then point the client patch at
# https://<domain> (docs/patch.md).

# Public domain for short links, redirects, well-known files.
# localhost for dev; e.g. links.yourdomain.com in production.
DETUR_DOMAIN=localhost

# SDK + pipeline listen address (inside the container, all interfaces).
DETUR_ADDR=:8080

# Portal listener. Binds 0.0.0.0 INSIDE the container; docker-compose
# publishes it on host loopback only (127.0.0.1:8081). Do NOT publish the
# portal port publicly — the portal has no auth (R19).
DETUR_PORTAL_ADDR=0.0.0.0:8081

# Portal static files (baked into the image at /app/portal-dist).
DETUR_PORTAL_DIR=/app/portal-dist

# SQLite file location (persisted via the detur-data volume).
DETUR_DB_PATH=/data/detur.db

# Click retention floor, hours (deterministic clickId lookups), 1-8760.
DETUR_RETENTION_HOURS=24

# Default probabilistic match window, minutes (5-180).
DETUR_WINDOW_MINUTES=15

# Default match threshold (700-1200).
DETUR_THRESHOLD=850

# Extra domains served on this instance, comma-separated, e.g.
# links.example.com,links.other.com (custom domains need their own TLS +
# a client-side host-matcher entry — docs/guide.md, docs/patch.md).
DETUR_EXTRA_DOMAINS=