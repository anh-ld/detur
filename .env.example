# Copy to .env. Docker: `docker run --env-file .env`.
# Prod: TLS required (API key + fingerprints).

# Links + well-known host, e.g. links.example.com.
DOMAIN=localhost

# SQLite path (in /data volume).
DB_PATH=/data/detur.db

# Hours clicks + events kept (24-8760).
RETENTION_HOURS=24

# Days unmatched click ID resolves (1-90), e.g. late Play referrer.
# Fingerprint still dropped at RETENTION_HOURS.
CLICK_ID_DAYS=30

# 1: client IP = rightmost X-Forwarded-For, else X-Real-IP. Real proxy only, else spoofable.
# 0: socket peer.
TRUST_PROXY=0

# Portal Log out link. Empty: hidden.
# URL or /path: /cdn-cgi/access/logout (Cloudflare Access), /oauth2/sign_out (oauth2-proxy),
# /.pomerium/sign_out (Pomerium).
LOGOUT_URL=

# Admin password. Others: view links + stats only.
# Empty: anyone manages apps; webhooks off.
# Long + random: session cookie = password. Change → all sessions out.
ADMIN_PASSWORD=

# Admin session hours (1-72). Lowering: live sessions keep old expiry.
ADMIN_SESSION_HOURS=12
