# detur runtime config. Copy to .env, edit, pass with `docker run --env-file .env`.
# TLS required in production: SDK bearer key + fingerprints must not go over plain http.

# Public domain for short links, redirects, well-known files (e.g. links.yourdomain.com).
DOMAIN=localhost

# SQLite file (inside the /data volume).
DB_PATH=/data/detur.db

# Min hours clicks + events are kept (24-8760).
RETENTION_HOURS=24

# Days an unmatched click ID still resolves (1-90), e.g. late Play referrer
# installs. Fingerprint dropped at RETENTION_HOURS either way.
CLICK_ID_DAYS=30

# 1 = client IP from the rightmost X-Forwarded-For entry (the peer your proxy saw),
# else X-Real-IP. Only behind a real proxy that appends to X-Forwarded-For (or
# overwrites X-Real-IP if it sets no XFF); otherwise clients spoof the IP match
# signal. 0 = socket peer address.
TRUST_PROXY=0

# Gateway sign-out URL for the portal's Log out link. Empty = no link.
# http(s) URL or /path, e.g. /cdn-cgi/access/logout (Cloudflare Access),
# /oauth2/sign_out (oauth2-proxy), /.pomerium/sign_out (Pomerium).
LOGOUT_URL=

# Master password for the portal's admin mode (sudo-style elevation). Everyone
# the gateway admits is a viewer (links + monitoring); this password unlocks
# admin actions for a bounded per-browser session. Empty = no gating: every
# admin action is open, exactly today's behavior. Must be long and random: the
# 1s wrong-password delay throttles online guesses only, and a captured session
# cookie is password-equivalent. Changing it invalidates all live sessions.
ADMIN_PASSWORD=

# Hours an elevated admin session lasts (1-72, default 12). Expiry enforced
# server-side on every gated request; lowering it does not shorten already
# minted sessions.
ADMIN_SESSION_HOURS=12
