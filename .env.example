# Copy this file to .env before starting.
# In production, Detour requires HTTPS (TLS) for universal and app links.

# Public domain where links and .well-known files are served (do not include https://).
DOMAIN=localhost

# Path to the SQLite database file (use /data/detur.db when running in Docker).
DB_PATH=/data/detur.db

# How long to keep raw clicks and events in hours (range: 24–8760). Purged hourly.
RETENTION_HOURS=24

# Window in days to resolve late Google Play Install Referrers (range: 1–90).
# Device fingerprints are still purged after RETENTION_HOURS.
CLICK_ID_DAYS=30

# Set to 1 if detur runs behind a reverse proxy (Nginx, Caddy, Cloudflare).
# Set to 0 if exposed directly to the internet (prevents client IP spoofing).
TRUST_PROXY=0

# Optional redirect URL for the portal's "Log out" button (leave empty to hide).
# Examples: /cdn-cgi/access/logout (Cloudflare Access), /oauth2/sign_out (oauth2-proxy).
LOGOUT_URL=

# Password required to manage apps and configure webhooks in the portal.
# If empty, anyone with portal access can manage apps (webhooks will be disabled).
# Changing this immediately logs out all active sessions.
ADMIN_PASSWORD=

# Session duration in hours before admin re-login is required (range: 1–72).
ADMIN_SESSION_HOURS=12

# Portal hostnames when a gateway (Cloudflare Access, Tailscale, nginx) serves the portal (comma-separated, no scheme).
# Loopback always works. Without this, requests through the gateway are rejected (403).
# Example: PORTAL_HOSTS=portal.example.com
PORTAL_HOSTS=
