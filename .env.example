# detur runtime config. Copy to .env, edit, pass with `docker run --env-file .env`.
# TLS required in production: SDK bearer key + fingerprints must not go over plain http.

# Public domain for short links, redirects, well-known files (e.g. links.yourdomain.com).
DOMAIN=localhost

# SQLite file (inside the /data volume).
DB_PATH=/data/detur.db

# Min hours clicks + events are kept (24-8760).
RETENTION_HOURS=24

# 1 = client IP from X-Forwarded-For. Only behind a proxy that overwrites the
# header, else clients can spoof the IP match signal. 0 = socket peer address.
TRUST_PROXY=0
