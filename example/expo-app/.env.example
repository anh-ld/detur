# App identity — create an app in the detur portal, copy its id + api key
EXPO_PUBLIC_DETOUR_APP_ID=your-app-id
EXPO_PUBLIC_DETOUR_API_KEY=your-api-key

# Comma-separated hostnames the native-intent matcher accepts.
# dev: localhost. deploy: your short-link domain(s), e.g. links.example.com
EXPO_PUBLIC_DETOUR_HOSTS=localhost